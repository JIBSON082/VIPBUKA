<section id="contact" class="py-24 px-5 bg-dark">
  <div class="max-w-5xl mx-auto">

    <div class="text-center mb-16 fade-up">
      <div class="section-label">Find Us</div>
      <h2
        class="font-playfair text-cream mb-4"
        style="font-size: clamp(1.75rem, 4vw, 2.75rem); font-weight: 600;"
      >
        Hungry?<br/>
        <em style="color: #E8900A; font-style: italic;">Let's feed you.</em>
      </h2>
      <p class="font-dm text-cream/50 text-sm max-w-md mx-auto leading-relaxed">
        Order through Chowdeck for delivery, send us a message on WhatsApp, or walk into any of our two Lagos branches.
      </p>
      <div class="gold-line mx-auto mt-6"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-14 fade-up">

      <div class="rounded-sm p-8" style="background: #181f19; border: 1px solid rgba(42,107,60,0.2);">
        <div class="section-label mb-4">Ajah Branch</div>
        <p class="font-playfair text-cream text-lg font-semibold mb-3 leading-snug">
          23 Mobil Estate Road,<br/>
          near Lajumak Shopping Centre,<br/>
          Ajah, Lagos State.
        </p>
        <a
          href="https://www.google.com/maps/search/VIP+BUKA+Ajah+23+Mobil+Estate+Road+Lagos"
          target="_blank"
          rel="noopener noreferrer"
          class="font-dm text-xs tracking-widest uppercase hover:text-cream transition-colors"
          style="color: #2A6B3C; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; margin-top: 0.5rem;"
        >
          Get Directions
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
            <path d="M1 9L9 1M9 1H3M9 1V7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </a>
      </div>

      <div class="rounded-sm p-8" style="background: #181f19; border: 1px solid rgba(42,107,60,0.2);">
        <div class="section-label mb-4">LUTH Branch</div>
        <p class="font-playfair text-cream text-lg font-semibold mb-3 leading-snug">
          Shop 5, Oph Shopping Complex,<br/>
          LUTH, Idi-Araba,<br/>
          Lagos State.
        </p>
        <a
          href="https://www.google.com/maps/search/VIP+BUKA+LUTH+Idi-Araba+Lagos"
          target="_blank"
          rel="noopener noreferrer"
          class="font-dm text-xs tracking-widest uppercase hover:text-cream transition-colors"
          style="color: #2A6B3C; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; margin-top: 0.5rem;"
        >
          Get Directions
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
            <path d="M1 9L9 1M9 1H3M9 1V7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-14 fade-up">
      <div>
        <div class="section-label mb-2">WhatsApp</div>
        <a href="https://wa.me/2347059653297" target="_blank" class="font-playfair text-cream text-lg hover:text-orange-brand transition-colors" style="text-decoration:none;">
          07059653297
        </a>
      </div>
      <div>
        <div class="section-label mb-2">Instagram</div>
        <a href="https://www.instagram.com/vipbuka_" target="_blank" class="font-playfair text-cream text-lg hover:text-orange-brand transition-colors" style="text-decoration:none;">
          @Vipbuka_
        </a>
