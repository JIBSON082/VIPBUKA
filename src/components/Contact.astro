        <a href="https://vm.tiktok.com/ZS9Ys6vWNqMfP-NPZe9/" target="_blank" class="font-playfair text-cream text-lg hover:text-orange-brand transition-colors" style="text-decoration:none;">
          @Vip_Buka
        </a>
      </div>
    </div>

    <div class="flex gap-4 flex-wrap justify-center fade-up">
      <a
        href="https://store.chowdeck.com/surulere/restaurants/vip-buka-idi-orodx93ut"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary"
