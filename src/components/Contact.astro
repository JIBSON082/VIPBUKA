    <!-- Brand + Tagline -->
    <div class="mb-6">
      <p class="font-playfair text-cream text-lg font-semibold">VIP BUKA</p>
      <p class="font-dm text-cream/30 text-xs italic mt-1">From our pots to your hearts.</p>
    </div>

   
    <!-- Social Icons -->
    <div class="flex gap-4 mb-6">
      <!-- Instagram -->
      <a href="https://www.instagram.com/vipbuka_" target="_blank" class="text-cream/30 hover:text-orange-brand transition-colors" aria-label="Instagram">
