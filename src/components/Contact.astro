      <a href="https://vm.tiktok.com/ZS9Ys6vWNqMfP-NPZe9/" target="_blank" class="font-dm text-xs tracking-widest uppercase text-cream/30 hover:text-orange-brand transition-colors" style="text-decoration:none;">TikTok</a>
      <a href="https://store.chowdeck.com/surulere/restaurants/vip-buka-idi-orodx93ut" target="_blank" class="font-dm text-xs tracking-widest uppercase text-cream/30 hover:text-orange-brand transition-colors" style="text-decoration:none;">Chowdeck</a>
