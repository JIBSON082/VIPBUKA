    </div>

    <!-- Divider -->
    <div style="border-top: 1px solid rgba(255,255,255,0.1);" class="mb-4"></div>

    <!-- Copyright -->
    <p class="font-dm text-cream/20 text-xs">© 2026 VIP Buka. All rights reserved.</p>

  </div>
</footer>