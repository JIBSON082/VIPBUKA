---
import FoodCarousel from './FoodCarousel.tsx';
---

<section id="hero" class="min-h-screen flex flex-col justify-center pt-14 pb-8 px-5 relative overflow-hidden">

  <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse at 70% 50%, rgba(42,107,60,0.06) 0%, transparent 60%);"></div>

  <div class="max-w-5xl mx-auto w-full relative">

    <div id="hero-brand" class="text-center mb-2">
      <h1
        class="font-playfair text-cream leading-[1.05] mb-4"
        style="font-size: clamp(2.2rem, 7vw, 5rem); font-weight: 700;"
      >
        Taste so spiritual,<br/>
        <em style="color: #E8900A; font-style: italic;">you might start speaking</em><br/>
        in flavors.
      </h1>
      <div class="gold-line mx-auto"></div>
    </div>

    <FoodCarousel client:load />

  </div>
</section>

<style>
  @keyframes heroFadeIn {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  #hero-brand {
    animation: heroFadeIn 1s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
  }
</style>