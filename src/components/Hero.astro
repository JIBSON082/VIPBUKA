---
import FoodCarousel from './FoodCarousel.tsx';
---

<section id="hero" class="min-h-screen flex flex-col justify-center pt-24 pb-16 px-5 relative overflow-hidden">

  <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse at 70% 50%, rgba(42,107,60,0.06) 0%, transparent 60%);"></div>

  <div class="max-w-5xl mx-auto w-full relative z-10">

    <!-- Animated cycling words -->
    <div id="hero-brand" class="text-center mb-8">

      <!-- Static prefix line -->
      <div
        class="font-dm uppercase tracking-[0.25em] mb-3"
        style="font-size: clamp(0.55rem, 1.5vw, 0.7rem); color: rgba(249,246,241,0.35);"
      >
        Now serving
      </div>

      <!-- The cycling word stage -->
      <div
        style="
          position: relative;
          height: clamp(3.5rem, 12vw, 6rem);
          overflow: hidden;
          display: flex;
          align-items: center;
          justify-content: center;
        "
      >
        <div id="word-stage" style="position: relative; width: 100%; text-align: center;">
          <!-- Words injected by JS -->
        </div>
      </div>

      <!-- Gold line -->
      <div class="gold-line mx-auto mt-4 mb-3"></div>

    </div>

    <FoodCarousel client:load />

  </div>
</section>

<style>
  .word-enter {
    animation: wordIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .word-exit {
    animation: wordOut 0.5s cubic-bezier(0.4, 0, 1, 1) forwards;
  }

  @keyframes wordIn {
    0%   { opacity: 0; transform: translateY(60%) skewY(4deg); clip-path: inset(0 0 100% 0); }
    100% { opacity: 1; transform: translateY(0)   skewY(0deg); clip-path: inset(0 0 0% 0); }
  }
  @keyframes wordOut {
    0%   { opacity: 1; transform: translateY(0)    skewY(0deg);  clip-path: inset(0 0 0% 0); }
    100% { opacity: 0; transform: translateY(-50%) skewY(-3deg); clip-path: inset(100% 0 0 0); }
  }

  @keyframes heroFadeIn {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  #hero-brand {
    animation: heroFadeIn 1s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
  }
</style>

<script>
  const words = [
    { text: "Dine In",           color: "#F9F6F1" },
    { text: "Take Out",          color: "#E8900A" },
    { text: "Catering",          color: "#F9F6F1" },
    { text: "Delivery",          color: "#2A6B3C" },
  ];

  const stage = document.getElementById('word-stage');
  if (stage) {
    let current = 0;
    let activeEl: HTMLElement | null = null;

    function showWord(index: number) {
      // Exit current
      if (activeEl) {
        const exiting = activeEl;
        exiting.classList.remove('word-enter');
        exiting.classList.add('word-exit');
        setTimeout(() => exiting.remove(), 500);
      }

      // Create new
      const w = words[index];
      const el = document.createElement('div');
      el.textContent = w.text;
      el.classList.add('word-enter');
      el.style.cssText = `
        position: absolute;
        width: 100%;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        font-family: 'Playfair Display', serif;
        font-size: clamp(2.4rem, 10vw, 5.5rem);
        font-weight: 700;
        font-style: italic;
        color: ${w.color};
        line-height: 1;
        letter-spacing: -0.01em;
        pointer-events: none;
      `;
      stage.appendChild(el);
      activeEl = el;
    }

    // Start
    showWord(0);
    setInterval(() => {
      current = (current + 1) % words.length;
      showWord(current);
    }, 2200);
  }
</script>