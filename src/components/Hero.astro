---
import FoodCarousel from './FoodCarousel.tsx';
---

<section id="hero" class="min-h-screen flex flex-col justify-center pt-0 pb-6 px-5 relative overflow-hidden">

  <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse at 70% 50%, rgba(42,107,60,0.06) 0%, transparent 60%);"></div>

  <div class="max-w-5xl mx-auto w-full relative">

    <FoodCarousel client:load />

  </div>
</section>

<style>
  @keyframes heroFadeIn {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  #hero-brand {
    animation: heroFadeIn 1s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
  }
</style>