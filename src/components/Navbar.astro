---
const logoUrl = "https://res.cloudinary.com/dx3k7hbnc/image/upload/v1779611055/Pokecut_1779610926804_fxnypc.png";
---

<nav id="navbar" class="fixed top-0 left-0 right-0 z-[100] transition-all duration-500">
  <div class="max-w-7xl mx-auto px-5 py-4 flex items-center justify-between relative">

    <!-- Wordmark Left -->
    <a href="/" style="text-decoration: none; display: inline-flex; align-items: center; gap: 0.6rem; cursor: pointer;">
      <span style="
        font-family: 'Playfair Display', sans-serif;
        font-size: 2.05rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: transparent;
        -webkit-text-stroke: 2px rgba(249,246,241,1);
        line-height: 1;
      ">VIP</span>
      <span style="
        width: 2px;
        height: 2rem;
        background: linear-gradient(to bottom, transparent, rgba(232,144,10,0.9), transparent);
        display: inline-block;
        flex-shrink: 0;
      "></span>
      <span style="
        font-family: 'Playfair Display', sans-serif;
        font-size: 2.05rem;
        font-weight: 600;
        letter-spacing: 0.01em;
        text-transform: uppercase;
        background: linear-gradient(135deg, #c46a00 0%, #E8900A 20%, #f7c56e 50%, #E8900A 80%, #c46a00 100%);
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        filter: drop-shadow(0 0 8px rgba(232,144,10,0.9))
                drop-shadow(0 0 20px rgba(232,144,10,0.6))
                drop-shadow(0 0 45px rgba(232,144,10,0.3))
                drop-shadow(0 0 80px rgba(232,144,10,0.15));
        line-height: 1;
        animation: goldShimmer 3s linear infinite;
        will-change: background-position;
      ">BUKA</span>
    </a>

    <!-- Hamburger Right -->
    <button
      id="hamburger"
      aria-label="Open menu"
      class="relative flex flex-col justify-center items-center cursor-pointer"
      style="width: 36px; height: 36px; background: none; border: none; padding: 0;"
    >
      <span id="ham-top" style="
        display: block;
        position: absolute;
        width: 32px;
        height: 2px;
        background: #F9F6F1;
        border-radius: 2px;
        transform: translateY(-9px);
        transition: transform 0.4s cubic-bezier(0.23, 1, 0.32, 1),
                    width 0.3s ease,
                    opacity 0.3s ease;
      "></span>
      <span id="ham-mid" style="
        display: block;
        position: absolute;
        width: 20px;
        height: 2px;
        background: #F9F6F1;
        border-radius: 2px;
        transform: translateY(0px);
        transition: opacity 0.25s ease,
                    width 0.3s ease,
                    transform 0.4s cubic-bezier(0.23, 1, 0.32, 1);
      "></span>
      <span id="ham-bot" style="
        display: block;
        position: absolute;
        width: 32px;
        height: 2px;
        background: #F9F6F1;
        border-radius: 2px;
        transform: translateY(9px);
        transition: transform 0.4s cubic-bezier(0.23, 1, 0.32, 1),
                    width 0.3s ease,
                    opacity 0.3s ease;
      "></span>
    </button>

  </div>
</nav>

<!-- Nav Drawer -->
<div id="nav-drawer" class="fixed inset-0 z-[9999] pointer-events-none">

  <!-- Backdrop -->
  <div
    id="nav-backdrop"
    class="absolute inset-0 opacity-0 transition-opacity duration-500"
    style="background: rgba(17,20,17,0.75);"
  ></div>

  <!-- Panel -->
  <div
    id="nav-panel"
    class="absolute top-0 left-0 h-full w-[80%] max-w-sm flex flex-col -translate-x-full transition-transform duration-500 ease-out"
    style="background: #0f1510; isolation: isolate;"
  >

    <!-- Top bar -->
    <div class="flex items-center justify-between px-7 py-6" style="border-bottom: 1px solid rgba(42,107,60,0.2);">
      <div style="display: inline-flex; align-items: center; gap: 0.4rem;">
        <span style="
          font-family: 'Playfair Display', sans-serif;
          font-size: 1.6rem;
          font-weight: 700;
          letter-spacing: 0.15em;
          color: transparent;
          -webkit-text-stroke: 1.5px rgba(249,246,241,1);
          line-height: 1;
        ">VIP</span>
        <span style="
          width: 1.5px;
          height: 1.2rem;
          background: linear-gradient(to bottom, transparent, rgba(232,144,10,0.9), transparent);
          display: inline-block;
        "></span>
        <span style="
          font-family: 'Playfair Display', sans-serif;
          font-size: 1.6rem;
          font-weight: 700;
          letter-spacing: 0.08em;
          background: linear-gradient(135deg, #c46a00 0%, #E8900A 20%, #f7c56e 50%, #E8900A 80%, #c46a00 100%);
          background-size: 200% auto;
          -webkit-background-clip: text;
          -webkit-text-fill-color: transparent;
          background-clip: text;
          filter: drop-shadow(0 0 8px rgba(232,144,10,0.7));
          line-height: 1;
        ">BUKA</span>
      </div>
      <button id="close-drawer" aria-label="Close menu" class="text-cream/40 hover:text-cream transition-colors">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
          <path d="M1 1L17 17M17 1L1 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <!-- Nav Links -->
    <nav class="flex flex-col flex-1 px-7 pt-4">
      {[
        { label: "Home",      href: "#hero" },
        { label: "Our Story", href: "#story" },
        { label: "Menu",      href: "#menu" },
        { label: "Reviews",   href: "#testimonials" },
        { label: "Contact",   href: "#contact" },
      ].map((link) => (
        <a
          href={link.href}
          onclick="closeDrawer()"
          class="nav-drawer-link group flex items-center justify-between py-5 transition-colors duration-200 hover:text-orange-brand"
          style="border-bottom: 1px solid rgba(42,107,60,0.15); text-decoration: none; color: #F9F6F1;"
        >
          <span style="font-family: 'Playfair Display', serif; font-size: 1.4rem; font-weight: 400;">
            {link.label}
          </span>
          <svg width="8" height="14" viewBox="0 0 8 14" fill="none" class="opacity-20 group-hover:opacity-60 transition-opacity">
            <path d="M1 1L7 7L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </a>
      ))}
    </nav>

    <!-- Bottom Section -->
    <div class="px-7 pb-10 pt-6">

      <a
        href="https://store.chowdeck.com/surulere/restaurants/vip-buka-idi-orodx93ut"
        target="_blank"
        rel="noopener noreferrer"
        onclick="closeDrawer()"
        class="block w-full text-center mb-3 py-3 rounded-sm font-dm text-xs font-semibold tracking-widest uppercase"
        style="background: #2A6B3C; color: #F9F6F1; text-decoration: none; letter-spacing: 0.15em;"
      >
        Order on Chowdeck
      </a>

      <a
        href="https://wa.me/2347059653297"
        target="_blank"
        rel="noopener noreferrer"
        onclick="closeDrawer()"
        class="block w-full text-center mb-6 py-3 rounded-sm font-dm text-xs font-semibold tracking-widest uppercase"
        style="border: 1px solid rgba(42,107,60,0.5); color: #F9F6F1; text-decoration: none; letter-spacing: 0.15em;"
      >
        Send Us a Message
      </a>

      <div style="height: 1px; background: rgba(42,107,60,0.2); margin-bottom: 1.25rem;"></div>

      <div class="flex flex-col gap-3">
        <div class="font-dm text-cream/25" style="font-size: 0.6rem; letter-spacing: 0.3em; text-transform: uppercase; margin-bottom: 4px;">
          Follow Us
        </div>
        {[
          { label: "Instagram", href: "https://www.instagram.com/vipbuka_" },
          { label: "TikTok",    href: "https://vm.tiktok.com/ZS9Ys6vWNqMfP-NPZe9/" },
        ].map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between group"
            style="text-decoration: none;"
          >
            <span
              class="font-dm group-hover:text-cream transition-colors"
              style="font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(249,246,241,0.35);"
            >
              {s.label}
            </span>
            <svg width="8" height="8" viewBox="0 0 10 10" fill="none" class="opacity-20 group-hover:opacity-60 transition-opacity">
              <path d="M1 9L9 1M9 1H3M9 1V7" stroke="#F9F6F1" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </a>
        ))}
      </div>

      <p class="font-playfair mt-8 italic" style="font-size: 0.8rem; color: rgba(249,246,241,0.15);">
        From our pots to your hearts.
      </p>

    </div>
  </div>
</div>

<style>
  @keyframes goldShimmer {
    0%   { background-position: 0% center; }
    100% { background-position: 200% center; }
  }
</style>

<script>
  const navbar    = document.getElementById('navbar');
  const hamburger = document.getElementById('hamburger');
  const closeBtn  = document.getElementById('close-drawer');
  const drawer    = document.getElementById('nav-drawer');
  const backdrop  = document.getElementById('nav-backdrop');
  const panel     = document.getElementById('nav-panel');

  const hamTop = document.getElementById('ham-top');
  const hamMid = document.getElementById('ham-mid');
  const hamBot = document.getElementById('ham-bot');

  let isOpen = false;

  window.addEventListener('scroll', () => {
  if (window.scrollY > 60) {
    navbar?.classList.add('bg-[#111411]', 'border-b', 'border-[rgba(42,107,60,0.15)]');
  } else {
    navbar?.classList.remove('bg-[#111411]', 'border-b', 'border-[rgba(42,107,60,0.15)]');
  }
});

  function animateOpen() {
    if (!hamTop || !hamMid || !hamBot) return;
    hamTop.style.transform = 'translateY(0px) rotate(45deg)';
    hamTop.style.width = '32px';
    hamMid.style.opacity = '0';
    hamMid.style.transform = 'translateX(-8px)';
    hamBot.style.transform = 'translateY(0px) rotate(-45deg)';
    hamBot.style.width = '32px';
  }

  function animateClose() {
    if (!hamTop || !hamMid || !hamBot) return;
    hamTop.style.transform = 'translateY(-9px) rotate(0deg)';
    hamTop.style.width = '32px';
    hamMid.style.opacity = '1';
    hamMid.style.transform = 'translateX(0px)';
    hamBot.style.transform = 'translateY(9px) rotate(0deg)';
    hamBot.style.width = '32px';
  }

  function openDrawer() {
    isOpen = true;
    animateOpen();
    drawer!.classList.remove('pointer-events-none');
    backdrop!.classList.remove('opacity-0');
    backdrop!.classList.add('opacity-100');
    panel!.classList.remove('-translate-x-full');
    panel!.classList.add('translate-x-0');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    isOpen = false;
    animateClose();
    drawer!.classList.add('pointer-events-none');
    backdrop!.classList.remove('opacity-100');
    backdrop!.classList.add('opacity-0');
    panel!.classList.remove('translate-x-0');
    panel!.classList.add('-translate-x-full');
    document.body.style.overflow = '';
  }

  (window as any).closeDrawer = closeDrawer;
  hamburger?.addEventListener('click', () => isOpen ? closeDrawer() : openDrawer());
  closeBtn?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);
</script>