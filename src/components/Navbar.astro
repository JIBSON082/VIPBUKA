---
const logoUrl = "https://res.cloudinary.com/dx3k7hbnc/image/upload/v1779611055/Pokecut_1779610926804_fxnypc.png";
---

<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500">
  <div class="max-w-7xl mx-auto px-5 py-4 flex items-center justify-between">

    <button
      id="hamburger"
      aria-label="Open menu"
      class="flex flex-col gap-[5px] cursor-pointer group"
    >
      <span class="block w-6 h-[1.5px] bg-cream transition-all duration-300 group-hover:w-8"></span>
      <span class="block w-4 h-[1.5px] bg-cream transition-all duration-300 group-hover:w-8"></span>
      <span class="block w-6 h-[1.5px] bg-cream transition-all duration-300 group-hover:w-8"></span>
    </button>

    <a href="/" aria-label="VIP Buka Home">
      <img
        src={logoUrl}
        alt="VIP Buka"
        class="h-10 w-auto object-contain"
        loading="eager"
      />
    </a>
  </div>
</nav>

<div id="nav-drawer" class="fixed inset-0 z-[200] pointer-events-none">
  <div
    id="nav-backdrop"
    class="absolute inset-0 bg-ink/80 backdrop-blur-sm opacity-0 transition-opacity duration-400"
  ></div>

  <div
    id="nav-panel"
    class="absolute top-0 left-0 h-full w-72 bg-[#111411] border-r border-[rgba(42,107,60,0.2)] flex flex-col p-8 -translate-x-full transition-transform duration-400 ease-out"
  >
    <button id="close-drawer" class="self-end mb-12 text-cream/50 hover:text-cream transition-colors">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
        <path d="M1 1L19 19M19 1L1 19" stroke="currentColor" stroke-width="1.5"/>
      </svg>
    </button>

    <nav class="flex flex-col gap-8">
      <a href="#hero" class="font-playfair text-2xl text-cream hover:text-orange-brand transition-colors" onclick="closeDrawer()">Home</a>
      <a href="#story" class="font-playfair text-2xl text-cream hover:text-orange-brand transition-colors" onclick="closeDrawer()">Our Story</a>
      <a href="#menu" class="font-playfair text-2xl text-cream hover:text-orange-brand transition-colors" onclick="closeDrawer()">Menu</a>
      <a href="#testimonials" class="font-playfair text-2xl text-cream hover:text-orange-brand transition-colors" onclick="closeDrawer()">Reviews</a>
      <a href="#contact" class="font-playfair text-2xl text-cream hover:text-orange-brand transition-colors" onclick="closeDrawer()">Contact</a>
    </nav>

    <div class="mt-auto flex flex-col gap-3">
      <div class="w-8 h-[1px] bg-orange-brand mb-4"></div>
      <a href="https://www.instagram.com/vipbuka_" target="_blank" class="font-dm text-xs tracking-widest uppercase text-cream/40 hover:text-orange-brand transition-colors">Instagram</a>
      <a href="https://vm.tiktok.com/ZS9Ys6vWNqMfP-NPZe9/" target="_blank" class="font-dm text-xs tracking-widest uppercase text-cream/40 hover:text-orange-brand transition-colors">TikTok</a>
      <a href="https://store.chowdeck.com/surulere/restaurants/vip-buka-idi-orodx93ut" target="_blank" class="font-dm text-xs tracking-widest uppercase text-cream/40 hover:text-orange-brand transition-colors">Chowdeck</a>
    </div>
  </div>
</div>

<script>
  const navbar = document.getElementById('navbar');
  const hamburger = document.getElementById('hamburger');
  const closeBtn = document.getElementById('close-drawer');
  const drawer = document.getElementById('nav-drawer');
  const backdrop = document.getElementById('nav-backdrop');
  const panel = document.getElementById('nav-panel');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 60) {
      navbar?.classList.add('bg-[#111411]/95', 'backdrop-blur-md', 'border-b', 'border-[rgba(42,107,60,0.15)]');
    } else {
      navbar?.classList.remove('bg-[#111411]/95', 'backdrop-blur-md', 'border-b', 'border-[rgba(42,107,60,0.15)]');
    }
  });

  function openDrawer() {
    drawer!.classList.remove('pointer-events-none');
    backdrop!.classList.remove('opacity-0');
    backdrop!.classList.add('opacity-100');
    panel!.classList.remove('-translate-x-full');
    panel!.classList.add('translate-x-0');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    drawer!.classList.add('pointer-events-none');
    backdrop!.classList.remove('opacity-100');
    backdrop!.classList.add('opacity-0');
    panel!.classList.remove('translate-x-0');
    panel!.classList.add('-translate-x-full');
    document.body.style.overflow = '';
  }

  (window as any).closeDrawer = closeDrawer;
  hamburger?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);
</script>
