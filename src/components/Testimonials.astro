---
const testimonials = [
  {
    quote: Most places charge a premium just for nice packaging. VIP Buka gives you great portions and real flavor without the price tag to match.,
    name: "David A.",
  },
  {
    quote: The jollof is exactly what they promise : smoky, rich, and hits the spot. I will definitely be ordering again.,
    name: "Esther T.",
  },
  {
    quote: It is hard to find a place that gets the local flavor right while keeping things clean and professional. They nailed it.,
    name: "Taiwo P.",
  },
  {
    quote: The yam and fish stew happens to be my favorite meal to get from HVIP and they have been consistent in delivering the same taste that drew me in.,
    name: "Favour C.",
  },
  {
    quote: One thing HVIP never misses is their Fried Rice and Jollof Rice. The flavor, quality, and consistency are always on point, and that is exactly what keeps me coming back for more.,
    name: "Ezekiel O.",
  },
  {
    quote: I got HVIP Jollof with beef and plantain from my church as exam brethren, and it was honestly one of the best meals I’ve had in a while. It tasted so good that I asked the delivery person where it was from because I already knew I’d be ordering it again.,
    name: "Omotola O.",
  },
];
---

<section id="testimonials" class="py-24 px-5" style="background: #181f19;">
  <div class="max-w-5xl mx-auto">

    <div class="text-center mb-14 fade-up">
       <div class="section-label mb-4" style="font-family: 'Cormorant Garamond', serif; font-style: normal; font-weight: 700; font-size: 1.6rem; letter-spacing: 0.05em; color: #E8900A;">What People Say</div>
      <h2
        class="font-playfair text-cream"
        style="font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 600;"
      >
        Real people. Real meals.<br/>
        <em style="color: #E8900A; font-style: italic;">Real talk.</em>
      </h2>
      <div class="gold-line mx-auto mt-5"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {testimonials.map((t, i) => (
        <div
          class="fade-up rounded-sm p-8 relative"
          style={`background: #111411; border: 1px solid rgba(42,107,60,0.15); animation-delay: ${i * 0.15}s;`}
        >
          <div
            class="font-playfair absolute top-6 right-8"
            style="font-size: 4rem; line-height: 1; color: rgba(232,144,10,0.2); font-weight: 600;"
          >
            "
          </div>

          <div class="w-8 h-[2px] mb-6" style="background: #E8900A;"></div>

          <p class="font-dm text-cream/60 text-sm leading-relaxed mb-8">
            {t.quote}
          </p>

          <div class="flex items-center gap-3">
            <div class="w-6 h-[1px]" style="background: #2A6B3C;"></div>
            <span class="font-dm text-xs font-semibold tracking-widest uppercase" style="color: #2A6B3C;">
              {t.name}
            </span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
