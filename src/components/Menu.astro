<section id="menu" class="py-24 px-5 bg-dark">
  <div class="max-w-5xl mx-auto">

    <!-- Header -->
    <div class="text-center mb-14 fade-up">
      <div class="section-label">What We Serve</div>
      <h2
        class="font-fraunces text-cream"
        style="font-size: clamp(1.75rem, 4vw, 2.75rem); font-weight: 600;"
      >
        Freshly made.<br/>
        <em style="color: #E8900A; font-style: italic;">Everyday favorites.</em>
      </h2>
      <div class="gold-line mx-auto mt-5"></div>
    </div>

    <!-- 4-image grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-14">
      {menuImages.map((item, i) => (
        <div
          class="fade-up group relative rounded-sm overflow-hidden cursor-pointer"
          style={`aspect-ratio: 3/4; animation-delay: ${i * 0.1}s;`}
        >
          <img
            src={item.image}
            alt={item.name}
            loading="lazy"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          />
          <!-- Overlay -->
          <div class="absolute inset-0 transition-opacity duration-300"
            style="background: linear-gradient(to top, rgba(17,20,17,0.9) 0%, rgba(17,20,17,0.2) 50%, transparent 100%);">
          </div>
          <!-- Text -->
          <div class="absolute bottom-0 left-0 right-0 p-4">
            <p class="font-fraunces text-cream text-sm font-semibold leading-tight mb-1">{item.name}</p>
            <p class="font-dm text-orange-brand text-xs font-semibold">{item.price}</p>
          </div>
          <!-- Green top accent -->
          <div class="absolute top-0 left-0 right-0 h-[2px] bg-green-brand opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center fade-up">
      <button
        id="open-menu-btn"
        class="btn-primary"
      >
        Explore Full Menu
      </button>
    </div>

  </div>
</section>

