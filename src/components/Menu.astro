<script>
  // Open / Close
  const openBtn = document.getElementById('open-menu-btn');
  const closeBtn = document.getElementById('close-menu-btn');
  const overlay = document.getElementById('menu-overlay');

  openBtn?.addEventListener('click', () => {
    overlay?.classList.add('open');
    document.body.style.overflow = 'hidden';
  });

  closeBtn?.addEventListener('click', () => {
    overlay?.classList.remove('open');
    document.body.style.overflow = '';
  });

  // Tabs
  const tabs = document.querySelectorAll('.menu-tab');
  const sections = document.querySelectorAll('.menu-section');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = tab.getAttribute('data-tab');

      // Update tab styles
      tabs.forEach(t => {
        (t as HTMLElement).style.background = 'transparent';
        (t as HTMLElement).style.color = '#1A1A1A';
      });
      (tab as HTMLElement).style.background = '#2A6B3C';
      (tab as HTMLElement).style.color = '#F9F6F1';

      // Show section
      sections.forEach(s => {
        if (s.getAttribute('data-section') === target) {
          s.classList.remove('hidden');
        } else {
          s.classList.add('hidden');
        }
      });

      // Scroll content to top
      document.getElementById('menu-content')?.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });
</script>
