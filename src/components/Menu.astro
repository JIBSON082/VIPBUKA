---
const menuImages = [
  {
    name: "Yam & Egg Sauce",
    image: "https://res.cloudinary.com/dx3k7hbnc/image/upload/v1779587822/1000522429_omruzg.png",
    price: "₦2,500",
  },
  {
    name: "Ogbono Soup & Swallow",
    image: "https://res.cloudinary.com/dx3k7hbnc/image/upload/v1779587849/file_00000000a9e071f48c138a330abce9c7_tt4q3t.png",
    price: "From ₦2,850",
  },
  {
    name: "Yam & Fish Sauce",
    image: "https://res.cloudinary.com/dx3k7hbnc/image/upload/v1779587823/ax6kjgrzcxrmt0cyay3vna987r_result_0_c0bwma.png",
    price: "₦2,500",
  },
  {
    name: "Fried Plantain",
    image: "https://res.cloudinary.com/dx3k7hbnc/image/upload/v1779587824/mk6rmg16x1rmr0cyaxe9nvyhf0_result_0_z4g4o1.jpg",
    price: "₦500",
  },
];
---

<section id="menu" class="py-24 px-5 bg-dark">
  <div class="max-w-5xl mx-auto">

    <!-- Header -->
    <div class="text-center mb-14 fade-up">
      <div class="section-label">What We Serve</div>
      <h2
        class="font-playfair text-cream"
        style="font-size: clamp(1.75rem, 4vw, 2.75rem); font-weight: 700;"
      >
        Freshly made.<br/>
        <em style="color: #E8900A; font-style: italic;">Everyday favorites.</em>
      </h2>
      <div class="gold-line mx-auto mt-5"></div>
    </div>

    <!-- 4-image grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-14">
      {menuImages.map((item, i) => (
        <div
          class="fade-up group relative rounded-sm overflow-hidden cursor-pointer"
          style={`aspect-ratio: 3/4; animation-delay: ${i * 0.1}s;`}
        >
          <img
            src={item.image}
            alt={item.name}
            loading="lazy"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          />
          <div
            class="absolute inset-0 transition-opacity duration-300"
            style="background: linear-gradient(to top, rgba(17,20,17,0.9) 0%, rgba(17,20,17,0.2) 50%, transparent 100%);"
          ></div>
          <div class="absolute bottom-0 left-0 right-0 p-4">
            <p class="font-playfair text-cream text-sm font-semibold leading-tight mb-1">{item.name}</p>
            <p class="font-dm text-xs font-semibold" style="color: #E8900A;">{item.price}</p>
          </div>
          <div class="absolute top-0 left-0 right-0 h-[2px] opacity-0 group-hover:opacity-100 transition-opacity duration-300" style="background: #2A6B3C;"></div>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center fade-up">
      <button id="open-menu-btn" class="btn-primary">
        Explore Full Menu
      </button>
    </div>

  </div>
</section>


<!-- ══════════════════════════════
     FULL MENU OVERLAY
══════════════════════════════ -->
<div id="menu-overlay" role="dialog" aria-modal="true" aria-label="Full Menu">
  <div style="background: #F9F6F1; min-height: 100vh; color: #1A1A1A;">

    <!-- Menu Header -->
    <div style="position: sticky; top: 0; z-index: 10; background: #F9F6F1; border-bottom: 1px solid rgba(42,107,60,0.15); padding: 1.25rem 1.5rem; display: flex; align-items: center; justify-content: space-between;">
      <div>
        <p style="font-family: 'DM Sans', sans-serif; font-size: 0.6rem; letter-spacing: 0.3em; text-transform: uppercase; color: #E8900A; margin-bottom: 4px;">VIP BUKA</p>
        <h2 style="font-family: 'Playfair Display', serif; font-size: 1.75rem; font-weight: 700; color: #1A1A1A;">
          Our <em style="color: #2A6B3C; font-style: italic;">Menu</em>
        </h2>
      </div>
      <button id="close-menu-btn" aria-label="Close menu" style="background: none; border: none; cursor: pointer; color: #1A1A1A; padding: 8px;">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M1 1L19 19M19 1L1 19" stroke="currentColor" stroke-width="1.5"/>
        </svg>
      </button>
    </div>

    <!-- Tabs -->
    <div id="menu-tabs" style="display: flex; gap: 0.5rem; padding: 1rem 1.5rem; overflow-x: auto; border-bottom: 1px solid rgba(42,107,60,0.1); scrollbar-width: none;">
      {["Rice & Pasta", "Yam", "Sides", "Proteins", "Swallows", "Soups"].map((tab, i) => (
        <button
          class="menu-tab"
          data-tab={tab}
          style={`flex-shrink:0; font-family:'DM Sans',sans-serif; font-size:0.7rem; font-weight:600; letter-spacing:0.12em; text-transform:uppercase; padding:0.5rem 1.1rem; border-radius:20px; cursor:pointer; transition:all 0.2s ease; border:1px solid rgba(42,107,60,0.3); background:${i === 0 ? '#2A6B3C' : 'transparent'}; color:${i === 0 ? '#F9F6F1' : '#1A1A1A'};`}
        >
          {tab}
        </button>
      ))}
    </div>

    <!-- Menu Content -->
    <div id="menu-content" style="max-width: 600px; margin: 0 auto; padding: 2rem 1.5rem;">

      <!-- Rice & Pasta -->
      <div class="menu-section" data-section="Rice & Pasta">
        <div style="font-family:'DM Sans',sans-serif; font-size:0.6rem; letter-spacing:0.3em; text-transform:uppercase; color:#E8900A; margin-bottom:1.5rem;">Per portion</div>
        {[
          { name: "Jollof Rice", price: "&#8358;300" },
          { name: "White Rice", price: "&#8358;300" },
          { name: "Fried Rice", price: "&#8358;300" },
          { name: "Beef Jollof Pasta", price: "&#8358;3,500" },
        ].map(item => (
          <div style="display:flex; justify-content:space-between; align-items:center; padding:1rem 0; border-bottom:1px solid rgba(42,107,60,0.1);">
            <span style="font-family:'Playfair Display',serif; font-size:1.05rem; font-weight:400; color:#1A1A1A;" set:html={item.name}></span>
            <span style="font-family:'DM Sans',sans-serif; font-size:0.85rem; font-weight:600; color:#2A6B3C;" set:html={item.price}></span>
          </div>
        ))}
      </div>

      <!-- Yam -->
      <div class="menu-section hidden" data-section="Yam">
        {[
          { name: "Yam & Egg Sauce", price: "&#8358;500" },
          { name: "Yam & Fish Sauce", price: "&#8358;500" },
        ].map(item => (
          <div style="display:flex; justify-content:space-between; align-items:center; padding:1rem 0; border-bottom:1px solid rgba(42,107,60,0.1);">
            <span style="font-family:'Playfair Display',serif; font-size:1.05rem; font-weight:400; color:#1A1A1A;" set:html={item.name}></span>
            <span style="font-family:'DM Sans',sans-serif; font-size:0.85rem; font-weight:600; color:#2A6B3C;" set:html={item.price}></span>
          </div>
        ))}
      </div>

      <!-- Sides -->
      <div class="menu-section hidden" data-section="Sides">
        <div style="font-family:'DM Sans',sans-serif; font-size:0.6rem; letter-spacing:0.3em; text-transform:uppercase; color:#E8900A; margin-bottom:1.5rem;">Per portion</div>
        {[
          { name: "Spaghetti", price: "&#8358;200" },
          { name: "Moi-Moi", price: "&#8358;300 / &#8358;500" },
          { name: "Plantain", price: "&#8358;200" },
          { name: "Coleslaw", price: "&#8358;500" },
          { name: "Beans", price: "&#8358;300" },
        ].map(item => (
          <div style="display:flex; justify-content:space-between; align-items:center; padding:1rem 0; border-bottom:1px solid rgba(42,107,60,0.1);">
            <span style="font-family:'Playfair Display',serif; font-size:1.05rem; font-weight:400; color:#1A1A1A;" set:html={item.name}></span>
            <span style="font-family:'DM Sans',sans-serif; font-size:0.85rem; font-weight:600; color:#2A6B3C;" set:html={item.price}></span>
          </div>
        ))}
      </div>

      <!-- Proteins -->
      <div class="menu-section hidden" data-section="Proteins">
        {[
          { name: "Egg", price: "&#8358;300" },
          { name: "Meat", price: "&#8358;200" },
          { name: "Ponmo", price: "&#8358;200" },
          { name: "Goat Meat", price: "&#8358;500" },
          { name: "Assorted Meat", price: "&#8358;200" },
          { name: "Chicken", price: "&#8358;1,500 / &#8358;2,000" },
          { name: "Fish", price: "&#8358;1,200 / &#8358;1,500" },
        ].map(item => (
          <div style="display:flex; justify-content:space-between; align-items:center; padding:1rem 0; border-bottom:1px solid rgba(42,107,60,0.1);">
            <span style="font-family:'Playfair Display',serif; font-size:1.05rem; font-weight:400; color:#1A1A1A;" set:html={item.name}></span>
            <span style="font-family:'DM Sans',sans-serif; font-size:0.85rem; font-weight:600; color:#2A6B3C;" set:html={item.price}></span>
          </div>
        ))}
      </div>

      <!-- Swallows -->
      <div class="menu-section hidden" data-section="Swallows">
        <div style="font-family:'DM Sans',sans-serif; font-size:0.6rem; letter-spacing:0.3em; text-transform:uppercase; color:#E8900A; margin-bottom:1.5rem;">Per wrap</div>
        {["Eba", "Fufu", "Semo", "Amala", "Poundo Yam"].map(name => (
          <div style="display:flex; justify-content:space-between; align-items:center; padding:1rem 0; border-bottom:1px solid rgba(42,107,60,0.1);">
            <span style="font-family:'Playfair Display',serif; font-size:1.05rem; font-weight:400; color:#1A1A1A;">{name}</span>
            <span style="font-family:'DM Sans',sans-serif; font-size:0.85rem; font-weight:600; color:#2A6B3C;">&#8358;500</span>
          </div>
        ))}
      </div>

      <!-- Soups -->
      <div class="menu-section hidden" data-section="Soups">
        {["Egusi Soup", "Ogbono Soup", "Vegetable Soup", "Okra Soup", "Ewedu & Gbegiri"].map(name => (
          <div style="display:flex; justify-content:space-between; align-items:center; padding:1rem 0; border-bottom:1px solid rgba(42,107,60,0.1);">
            <span style="font-family:'Playfair Display',serif; font-size:1.05rem; font-weight:400; color:#1A1A1A;">{name}</span>
            <span style="font-family:'DM Sans',sans-serif; font-size:0.85rem; font-weight:500; color:#888; font-style:italic;">Ask us</span>
          </div>
        ))}
      </div>

      <!-- Footer Brand + CTAs -->
      <div style="text-align:center; padding:2rem 0; margin-top:1rem;">
        <div style="display:flex; align-items:center; gap:1rem; justify-content:center; margin-bottom:2rem;">
          <div style="flex:1; height:1px; background:rgba(42,107,60,0.2);"></div>
          <span style="font-family:'Playfair Display',serif; font-size:0.9rem; color:#888; font-style:italic;">VIP Buka</span>
          <div style="flex:1; height:1px; background:rgba(42,107,60,0.2);"></div>
        </div>

        <div style="display:flex; gap:1rem; justify-content:center; flex-wrap:wrap;">
          <a
            href="https://store.chowdeck.com/surulere/restaurants/vip-buka-idi-orodx93ut"
            target="_blank"
            rel="noopener noreferrer"
            style="display:inline-flex; align-items:center; justify-content:center; background:#2A6B3C; color:#F9F6F1; font-family:'DM Sans',sans-serif; font-size:0.75rem; font-weight:600; letter-spacing:0.15em; text-transform:uppercase; padding:0.875rem 1.75rem; border-radius:20px; text-decoration:none;"
          >
            Order on Chowdeck
          </a>
          <a
            href="https://wa.me/2347059653297"
            target="_blank"
            rel="noopener noreferrer"
            style="display:inline-flex; align-items:center; justify-content:center; background:transparent; color:#1A1A1A; font-family:'DM Sans',sans-serif; font-size:0.75rem; font-weight:600; letter-spacing:0.15em; text-transform:uppercase; padding:0.875rem 1.75rem; border-radius:20px; border:1px solid rgba(42,107,60,0.4); text-decoration:none;"
          >
            Send us a DM
          </a>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  const openBtn = document.getElementById('open-menu-btn');
  const closeBtn = document.getElementById('close-menu-btn');
  const overlay = document.getElementById('menu-overlay');

  openBtn?.addEventListener('click', () => {
    overlay?.classList.add('open');
    document.body.style.overflow = 'hidden';
  });

  closeBtn?.addEventListener('click', () => {
    overlay?.classList.remove('open');
    document.body.style.overflow = '';
  });

  const tabs = document.querySelectorAll('.menu-tab');
  const sections = document.querySelectorAll('.menu-section');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = tab.getAttribute('data-tab');

      tabs.forEach(t => {
        (t as HTMLElement).style.background = 'transparent';
        (t as HTMLElement).style.color = '#1A1A1A';
      });
      (tab as HTMLElement).style.background = '#2A6B3C';
      (tab as HTMLElement).style.color = '#F9F6F1';

      sections.forEach(s => {
        if (s.getAttribute('data-section') === target) {
          s.classList.remove('hidden');
        } else {
          s.classList.add('hidden');
        }
      });
    });
  });
</script>