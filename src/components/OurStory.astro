---
---

<section id="story" class="py-24 px-5" style="background: #181f19;">
  <div class="max-w-5xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-start">

      <!-- VIDEO CARD -->
      <div class="fade-up relative">

        <!-- Our Story label above video -->
       <div class="section-label mb-4" style="font-size: 1.5rem;">Our Story</div>
        <div
          class="relative rounded-sm overflow-hidden"
          style="aspect-ratio: 3/4; min-height: 560px; background: #111411; border: 1px solid rgba(42,107,60,0.2);"
        >
          <!-- Corner accents -->
          <div class="absolute top-0 left-0 w-12 h-1 z-10" style="background: #E8900A;"></div>
          <div class="absolute bottom-0 right-0 w-12 h-1 z-10" style="background: #2A6B3C;"></div>

          <!-- Video -->
          <video
            id="story-video"
            autoplay
            muted
            loop
            playsinline
            style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block;"
          >
            <source
              src="https://res.cloudinary.com/dx3k7hbnc/video/upload/VIP_BUKA_STORY_xranyd.mp4"
              type="video/mp4"
            />
          </video>

          <!-- Bottom vignette -->
          <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(10,14,10,0.72) 0%, rgba(10,14,10,0.0) 35%); pointer-events: none; z-index: 2;"></div>

          <!-- Controls -->
          <div style="position: absolute; bottom: 0; left: 0; right: 0; z-index: 3; display: flex; align-items: center; justify-content: space-between; padding: 14px 16px;">

            <!-- Play / Pause -->
            <button id="story-playpause" aria-label="Play or pause"
              style="width: 36px; height: 36px; border-radius: 50%; background: rgba(17,20,17,0.7); border: 1px solid rgba(249,246,241,0.15); display: flex; align-items: center; justify-content: center; cursor: pointer; color: #F9F6F1; backdrop-filter: blur(6px);">
              <svg id="icon-pause" width="12" height="12" viewBox="0 0 12 12" fill="none">
                <rect x="2" y="1.5" width="3" height="9" rx="1" fill="currentColor"/>
                <rect x="7" y="1.5" width="3" height="9" rx="1" fill="currentColor"/>
              </svg>
              <svg id="icon-play" width="12" height="12" viewBox="0 0 12 12" fill="none" style="display:none;">
                <path d="M2.5 1.5L10.5 6L2.5 10.5V1.5Z" fill="currentColor"/>
              </svg>
            </button>

            <!-- Mute / Unmute -->
            <button id="story-mute" aria-label="Mute or unmute"
              style="width: 36px; height: 36px; border-radius: 50%; background: rgba(17,20,17,0.7); border: 1px solid rgba(249,246,241,0.15); display: flex; align-items: center; justify-content: center; cursor: pointer; color: #F9F6F1; backdrop-filter: blur(6px);">
              <svg id="icon-muted" width="14" height="12" viewBox="0 0 14 12" fill="none">
                <path d="M1 4H3.5L7 1V11L3.5 8H1V4Z" fill="currentColor"/>
                <path d="M10 4L13 8M13 4L10 8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
              </svg>
              <svg id="icon-unmuted" width="14" height="12" viewBox="0 0 14 12" fill="none" style="display:none;">
                <path d="M1 4H3.5L7 1V11L3.5 8H1V4Z" fill="currentColor"/>
                <path d="M9.5 3.5C10.5 4.5 10.5 7.5 9.5 8.5M11.5 2C13.2 3.7 13.2 8.3 11.5 10" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
              </svg>
            </button>

          </div>
        </div>
      </div>

      <!-- TEXT SIDE -->
      <div class="fade-up flex flex-col justify-start">

        <h2
          class="font-playfair text-cream mb-6"
          style="font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 600; line-height: 1.2;"
        >
          Good food should be two things —<br/>
          <em style="color: #E8900A; font-style: italic;">affordable</em> and deeply satisfying.
        </h2>

        <div class="gold-line"></div>

        <div class="flex flex-col gap-5 mt-6">
          <p class="font-dm text-cream/60 leading-relaxed text-sm">
            Expensive food that disappoints is not a flex. That is the idea we built this place on.
          </p>
          <p class="font-dm text-cream/60 leading-relaxed text-sm">
            We started VIP Buka to serve the rich, familiar flavors of a traditional local buka — with the clean, consistent standard the everyday person actually deserves.
          </p>
          <p class="font-dm text-cream/60 leading-relaxed text-sm">
            Real ingredients. Real portions. No shortcuts. Just food that reminds you why Nigerian cooking is in a category of its own.
          </p>
        </div>

        <p class="font-playfair mt-8 italic" style="font-size: 1.1rem; color: #E8900A;">
          From our pots to your hearts.
        </p>

      </div>

    </div>
  </div>
</section>

<script>
  const video = document.getElementById('story-video') as HTMLVideoElement;
  const playPauseBtn = document.getElementById('story-playpause');
  const muteBtn = document.getElementById('story-mute');
  const iconPause = document.getElementById('icon-pause');
  const iconPlay = document.getElementById('icon-play');
  const iconMuted = document.getElementById('icon-muted');
  const iconUnmuted = document.getElementById('icon-unmuted');

  playPauseBtn?.addEventListener('click', () => {
    if (!video) return;
    if (video.paused) {
      video.play();
      iconPause!.style.display = 'block';
      iconPlay!.style.display = 'none';
    } else {
      video.pause();
      iconPause!.style.display = 'none';
      iconPlay!.style.display = 'block';
    }
  });

  muteBtn?.addEventListener('click', () => {
    if (!video) return;
    video.muted = !video.muted;
    if (video.muted) {
      iconMuted!.style.display = 'block';
      iconUnmuted!.style.display = 'none';
    } else {
      iconMuted!.style.display = 'none';
      iconUnmuted!.style.display = 'block';
    }
  });
</script>